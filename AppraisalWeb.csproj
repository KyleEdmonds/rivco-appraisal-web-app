<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- Pin the native SQLite binary to a build bundling SQLite >= 3.50.2 to fix
         CVE-2025-6965 (memory corruption in SQLite < 3.50.2, GHSA-2m69-gcr7-jv3q).
         Only the native lib is swapped; the managed SQLitePCLRaw.core/provider stay
         at 2.1.11 (pulled in by Microsoft.Data.Sqlite). Standalone native binary,
         no dependencies, stable SQLite C API. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <!-- share/ is a distribution copy for IT, not source. Keep it out of the build. -->
  <ItemGroup>
    <Compile Remove="share\**" />
    <Content Remove="share\**" />
    <None Remove="share\**" />
  </ItemGroup>

</Project>
