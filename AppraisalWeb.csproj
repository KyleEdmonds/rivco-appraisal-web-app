<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <!-- GDI+ image compositing: draws the parcel outline onto the cached
         satellite PNG so every consumer (cover tab, PDF, PIN page) gets the
         red parcel boundary in one image. Windows-only, which matches this
         app's deployment target. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <!-- Pin the native SQLite binary to a build bundling SQLite >= 3.50.2 to fix
         CVE-2025-6965 (memory corruption in SQLite < 3.50.2, GHSA-2m69-gcr7-jv3q).
         Only the native lib is swapped; the managed SQLitePCLRaw.core/provider stay
         at 2.1.11 (pulled in by Microsoft.Data.Sqlite). Standalone native binary,
         no dependencies, stable SQLite C API. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
  </ItemGroup>

  <!-- share/ is a distribution copy for IT, not source. Keep it out of the build. -->
  <ItemGroup>
    <Compile Remove="share\**" />
    <Content Remove="share\**" />
    <None Remove="share\**" />
  </ItemGroup>

  <!-- storage/ is an archive of the data-prep pipeline (scripts + raw/intermediate
       data, incl. a standalone Program.cs probe). Keep it out of the web build so
       its top-level Program.cs is not globbed in as a second entry point. -->
  <ItemGroup>
    <Compile Remove="storage\**" />
    <Content Remove="storage\**" />
    <None Remove="storage\**" />
  </ItemGroup>

  <!-- output/ is a data folder (parcel_data.json + generated appraisal deliverables).
       Exclude it from the web build so any stray .cs/.csproj there is not globbed in
       as a second entry point. -->
  <ItemGroup>
    <Compile Remove="output\**" />
    <Content Remove="output\**" />
    <None Remove="output\**" />
  </ItemGroup>

</Project>
